---
/**
 * App Access Database — 存档展示页(对标 Speed Test Database)。
 * 数据来源:各 provider JSON 里的 appAccess 数组。
 * 新增一条实测:在对应 provider JSON 的 appAccess 里追加一个对象,
 * 把截图传到 public/appaccess/,填上 screenshot 文件名,这里自动显示。
 *
 * 显示开关:每个 provider 默认都会显示(listedAppAccess 默认 true)。
 * 想隐藏某家,在它的 JSON 里加 "listedAppAccess": false 即可。
 * (前提是这家 appAccess 里有数据 —— 开关不会凭空造出卡片。)
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

// 汇总所有 provider 的 appAccess,打上服务商标签,有日期的按日期倒序
const providers = await getCollection('providers');

interface AccessEntry {
  provider: string;
  app: string;
  works: boolean;
  notes?: string;
  city?: string;
  date?: string;
  screenshot?: string;
  video?: string;
  sampleData: boolean;
}

const allTests: AccessEntry[] = providers
  .filter((p) => p.data.listedAppAccess !== false)
  .flatMap((p) =>
    (p.data.appAccess ?? []).map((t) => ({
      provider: p.data.name,
      app: t.app,
      works: t.works,
      notes: t.notes,
      city: t.city,
      date: t.date,
      screenshot: t.screenshot,
      video: t.video,
      sampleData: p.data.sampleData ?? false,
    }))
  )
  .sort((a, b) => (b.date ?? '').localeCompare(a.date ?? '')); // 有日期的最新在前

const hasSampleData = allTests.some((t) => t.sampleData);
const total = allTests.length;
---

<Base
  title="App Access Database"
  description={`${total} real app-access checks from inside China — which apps open without a VPN, each timestamped and photographed.`}
>
  <section class="wrap">
    <div class="page-head">
      <h1>App Access Database</h1>
    </div>

    {hasSampleData && (
      <p class="sample-banner">
        Some rows below are sample data, shown for layout only — they'll be replaced with real field tests.
      </p>
    )}

    <div class="log">
      {allTests.map((t) => (
        <article class="entry card" data-sample={t.sampleData}>
          <div class="entry-meta">
            <span class="provider-tag">{t.provider}</span>
            {t.date && <span class="chip">{t.date}</span>}
            {t.city && <span class="chip">{t.city}</span>}
          </div>

          <div class="entry-body">
            {t.video ? (
              <a
                href={`/appaccess/${t.video}`}
                class="thumb-wrap"
                target="_blank"
                rel="noopener"
                aria-label={`Play clip: ${t.app} on ${t.provider}`}
              >
                {t.screenshot ? (
                  <img
                    src={`/appaccess/${t.screenshot}`}
                    alt={`${t.provider} — ${t.app} without a VPN${t.date ? `, ${t.date}` : ''}`}
                    class="thumb"
                    loading="lazy"
                    width="240"
                    height="160"
                  />
                ) : (
                  <span class="video-poster" aria-hidden="true"></span>
                )}
                <span class="play-badge" aria-hidden="true">▶</span>
                <span class="zoom-hint" aria-hidden="true">▶ play clip</span>
              </a>
            ) : t.screenshot ? (
              <a
                href={`/appaccess/${t.screenshot}`}
                class="thumb-wrap"
                target="_blank"
                rel="noopener"
                aria-label={`Full-size screenshot: ${t.app} on ${t.provider}`}
              >
                <img
                  src={`/appaccess/${t.screenshot}`}
                  alt={`${t.provider} — ${t.app} without a VPN${t.date ? `, ${t.date}` : ''}`}
                  class="thumb"
                  loading="lazy"
                  width="240"
                  height="160"
                />
                <span class="zoom-hint" aria-hidden="true">↗ full size</span>
              </a>
            ) : (
              <div class="no-shot">proof pending</div>
            )}

            <div class="detail">
              <span class="app-name">{t.app}</span>
              {t.works
                ? <span class="mark-pass">WORKS</span>
                : <span class="mark-fail">BLOCKED</span>}
              {t.notes && <p class="notes small muted">{t.notes}</p>}
            </div>
          </div>
        </article>
      ))}
    </div>

    {total === 0 && (
      <p class="muted">No app-access tests recorded yet — first field tests are underway.</p>
    )}

    <p class="small muted methodology">
      <strong>Methodology:</strong> Each app is opened cold on cellular data inside China, with no VPN and no proxy running. WORKS means it loaded and functioned normally; BLOCKED means it failed to connect. Screenshots are captured on-device with a visible timestamp. Each row is one app, on one eSIM, at one place and time.
    </p>
  </section>
</Base>

<style>
  .page-head { padding-top: 2rem; max-width: 44rem; margin-bottom: 2rem; }
  .page-head .chip { margin-right: 0.4rem; }

  .sample-banner {
    background: var(--amber-tint);
    color: var(--amber-ink);
    border: 1px solid #e8d9ae;
    border-radius: var(--radius);
    padding: 0.7rem 1rem;
    font-size: 0.9rem;
    margin-bottom: 1.5rem;
  }

  /* log grid */
  .log {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.1rem;
    margin-bottom: 2rem;
  }

  .entry { padding: 1rem; }
  .entry[data-sample="true"] { border-color: #e8d9ae; background: var(--amber-tint); }

  /* meta row */
  .entry-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    margin-bottom: 0.8rem;
  }
  .provider-tag {
    font-weight: 650;
    font-size: 0.9rem;
    margin-right: 0.15rem;
  }

  /* body: screenshot + result side by side */
  .entry-body {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  /* screenshot thumbnail */
  .thumb-wrap {
    position: relative;
    flex-shrink: 0;
    display: block;
    border-radius: 4px;
    overflow: hidden;
    border: 1px solid var(--line);
    text-decoration: none;
  }
  .thumb {
    display: block;
    width: 120px;
    height: 80px;
    object-fit: cover;
  }
  .zoom-hint {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    background: rgba(0,0,0,0.55);
    color: #fff;
    font-size: 0.65rem;
    text-align: center;
    padding: 0.15rem 0;
    opacity: 0;
    transition: opacity 120ms;
  }
  .thumb-wrap:hover .zoom-hint { opacity: 1; }

  /* video: play badge over the poster (or dark fallback) */
  .video-poster {
    display: block;
    width: 120px;
    height: 80px;
    background: #1a2421;
  }
  .play-badge {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: rgba(0,0,0,0.6);
    color: #fff;
    font-size: 0.7rem;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-left: 2px;
    pointer-events: none;
  }

  .no-shot {
    flex-shrink: 0;
    width: 120px;
    height: 80px;
    border: 1px dashed var(--line);
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.72rem;
    color: var(--ink-soft);
    font-family: var(--font-mono);
  }

  /* result detail */
  .detail {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.45rem;
  }
  .app-name { font-size: 1rem; font-weight: 600; }
  .notes { margin: 0; }

  .methodology { margin-top: 1rem; }

  @media (max-width: 480px) {
    .log { grid-template-columns: 1fr; }
  }
</style>
