---
// 放到 src/components/ReviewSchema.astro
// 评测页结构化数据：告诉 Google "这是一篇评测、评的是什么、几分"。但是他的作用不是让网页排名更靠前，是让网页排到了之后看起来更好看
// 有资格在搜索结果显示评分星星。演示数据(sampleData)时自动不输出，防止假数据进搜索结果。
import { SITE } from '../config/site';
import { overallScore } from '../config/metrics';

interface Props {
  provider: any; // providers 集合的条目
  post: any; // posts 集合的条目
}
const { provider, post } = Astro.props;

const score = overallScore(provider.data.scores, provider.data.category);

// 顶层用 Product,评分挂进 Product 内部的 review。
// 这样 Google 读 Product 时就能找到评分来源,满足
// "Either offers, review, or aggregateRating should be specified" 的要求。
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `${provider.data.name} for China`,
  brand: { '@type': 'Brand', name: provider.data.name },
  // description 兜底:文章没填 description 就用 provider 的 verdict,避免出现空字符串
  description: post.data.description || provider.data.verdict,
  image: `https://${SITE.domain}/og-default.png`,
  review: {
    '@type': 'Review',
    reviewRating: {
      '@type': 'Rating',
      ratingValue: score,
      bestRating: 10,
      worstRating: 0,
    },
    author: { '@type': 'Organization', name: SITE.name, url: `https://${SITE.domain}/about/` },
    datePublished: post.data.date,
    ...(post.data.updated ? { dateModified: post.data.updated } : {}),
  },
};
---

{
  /* 演示数据不输出 schema —— 假评分进了 Google 会伤信誉 */
  !provider.data.sampleData && (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  )
}
