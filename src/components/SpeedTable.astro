---
/** 实测速度表:城市、地点、网络、下/上行、日期。每条都是可追溯的证据。 */
interface Props {
  tests: {
    city: string;
    spot: string;
    network: string;
    downMbps: number;
    upMbps: number;
    hotspot?: string;
    date: string;
  }[];
  /** 超过每日高速额度后的限速,如 "throttled to 1 Mbps"。来自 provider 的 throttlePolicy.afterCap */
  afterCap?: string;
  /** 数据出口/落地路由说明。来自 provider 的 exitCountry */
  exitCountry?: string;
}
const { tests, afterCap, exitCountry } = Astro.props;
---

<h3>Speed tests on location</h3>
<div class="table-scroll">
  <table>
    <thead>
      <tr>
        <th scope="col">Location</th>
        <th scope="col">Network</th>
        <th scope="col">Down</th>
        <th scope="col">Up</th>
        <th scope="col">Hotspot</th>
        <th scope="col">Date</th>
      </tr>
    </thead>
    <tbody>
      {tests.map((t) => (
        <tr>
          <td>
            <strong>{t.city}</strong>
            <div class="small muted">{t.spot}</div>
          </td>
          <td class="mono">{t.network}</td>
          <td class="mono strong-num">{t.downMbps} Mbps</td>
          <td class="mono">{t.upMbps} Mbps</td>
          <td class="mono">{t.hotspot ?? '—'}</td>
          <td class="mono">{t.date}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
{afterCap && (
  <p class="small cap-note">
    <strong>After high-speed data runs out:</strong> {afterCap}
  </p>
)}
{exitCountry && (
  <p class="small muted exit">
    Data exit: <span class="mono">{exitCountry}</span>
  </p>
)}
<p class="small muted">
  Method: Ookla Speedtest, three runs per spot, median reported. VPN off, no background downloads.
  <a href="/speed-tests/">View all speed tests →</a>
</p>

<style>
  .strong-num { font-weight: 600; color: var(--jade-deep); }
  .cap-note { margin: 0.6rem 0 0; color: var(--ink-soft); }
  .cap-note strong { color: var(--ink); }
  .exit { margin: 0.6rem 0 0; }
</style>
